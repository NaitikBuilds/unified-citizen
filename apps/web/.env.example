# ------------------------------------------------------------------
# Unified Citizen Governance — frontend environment variables
# Copy to .env.local and adjust as needed. Nothing here is secret.
# ------------------------------------------------------------------

# Mock/API switch:
#   true  -> use in-memory mock services (no backend required) [default when unset]
#   false -> use the real backend API (apps/api, must be running)
VITE_USE_MOCK_API=true

# Backend API base URL (apps/api serves /api/v1 on port 5000 by default)
VITE_API_BASE_URL=http://localhost:5000/api/v1
