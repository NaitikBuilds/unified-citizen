generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String         @id @default(cuid())
  name               String
  email              String         @unique
  passwordHash       String
  phone              String?
  role               UserRole       @default(CITIZEN)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  departmentId       String?
  assignmentsCreated Assignment[]   @relation("AssignmentCreatedBy")
  assignments        Assignment[]   @relation("AssignedOfficer")
  attachments        Attachment[]
  auditLogs          AuditLog[]
  comments           Comment[]
  escalationsCreated Escalation[]   @relation("EscalationCreatedBy")
  feedback           Feedback[]
  grievances         Grievance[]    @relation("CitizenGrievances")
  notifications      Notification[]
  refreshTokens      RefreshToken[]
  department         Department?    @relation(fields: [departmentId], references: [id])

  @@index([email])
  @@index([departmentId])
  @@index([role])
}

model Department {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  code        String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  isActive    Boolean      @default(true)
  assignments Assignment[]
  grievances  Grievance[]
  slas        SLA[]
  slaPolicies SLAPolicy[]
  users       User[]

  @@index([isActive])
}

model Grievance {
  id               String            @id @default(cuid())
  ticketId         String            @unique
  title            String
  description      String
  category         String?
  subcategory      String?
  status           GrievanceStatus   @default(SUBMITTED)
  priority         GrievancePriority @default(MEDIUM)
  location         String?
  latitude         Float?
  longitude        Float?
  citizenId        String
  departmentId     String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  resolvedAt       DateTime?
  address          String?
  aiClassification AIClassification?
  assignments      Assignment[]
  attachments      Attachment[]
  auditLogs        AuditLog[]
  comments         Comment[]
  escalations      Escalation[]
  feedback         Feedback[]
  citizen          User              @relation("CitizenGrievances", fields: [citizenId], references: [id])
  department       Department?       @relation(fields: [departmentId], references: [id])
  notifications    Notification[]
  sla              SLA?

  @@index([ticketId])
  @@index([citizenId])
  @@index([departmentId])
  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([createdAt])
}

model Assignment {
  id           String           @id @default(cuid())
  grievanceId  String
  officerId    String
  departmentId String
  type         AssignmentType
  status       AssignmentStatus @default(ACTIVE)
  assignedById String?
  assignedAt   DateTime         @default(now())
  completedAt  DateTime?
  reason       String?
  assignedBy   User?            @relation("AssignmentCreatedBy", fields: [assignedById], references: [id])
  department   Department       @relation(fields: [departmentId], references: [id])
  grievance    Grievance        @relation(fields: [grievanceId], references: [id], onDelete: Cascade)
  officer      User             @relation("AssignedOfficer", fields: [officerId], references: [id])

  @@index([grievanceId])
  @@index([officerId])
  @@index([departmentId])
  @@index([assignedById])
  @@index([status])
}

model AIClassification {
  id             String             @id @default(cuid())
  grievanceId    String             @unique
  confidence     Float?
  modelName      String?
  modelVersion   String?
  explanation    String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  category       String?
  department     String?
  duplicateScore Float?
  priority       GrievancePriority?
  sentiment      String?
  severity       String?
  summary        String?
  grievance      Grievance          @relation(fields: [grievanceId], references: [id], onDelete: Cascade)

  @@index([category])
  @@index([department])
  @@index([priority])
}

model Comment {
  id          String    @id @default(cuid())
  grievanceId String
  isInternal  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  message     String
  userId      String
  grievance   Grievance @relation(fields: [grievanceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id])

  @@index([grievanceId])
  @@index([userId])
}

model Attachment {
  id           String     @id @default(cuid())
  fileName     String
  fileUrl      String
  fileType     String?
  fileSize     Int?
  grievanceId  String?
  uploadedById String
  createdAt    DateTime   @default(now())
  grievance    Grievance? @relation(fields: [grievanceId], references: [id], onDelete: Cascade)
  uploadedBy   User       @relation(fields: [uploadedById], references: [id])

  @@index([grievanceId])
  @@index([uploadedById])
}

model Notification {
  id          String           @id @default(cuid())
  type        NotificationType
  title       String
  message     String
  isRead      Boolean          @default(false)
  userId      String
  grievanceId String?
  createdAt   DateTime         @default(now())
  grievance   Grievance?       @relation(fields: [grievanceId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([grievanceId])
  @@index([isRead])
  @@index([createdAt])
}

model AuditLog {
  id          String     @id @default(cuid())
  action      String
  metadata    Json?
  userId      String?
  createdAt   DateTime   @default(now())
  grievanceId String?
  newValue    Json?
  oldValue    Json?
  grievance   Grievance? @relation(fields: [grievanceId], references: [id])
  user        User?      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([grievanceId])
  @@index([action])
  @@index([createdAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model SLAPolicy {
  id                  String             @id @default(cuid())
  name                String
  description         String?
  departmentId        String
  category            String?
  priority            GrievancePriority?
  responseTimeHours   Int
  resolutionTimeHours Int
  isActive            Boolean            @default(true)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  slas                SLA[]
  department          Department         @relation(fields: [departmentId], references: [id])

  @@index([departmentId])
  @@index([category])
  @@index([priority])
  @@index([isActive])
}

model SLA {
  id                    String     @id @default(cuid())
  grievanceId           String     @unique
  departmentId          String
  responseTimeHours     Int
  resolutionTimeHours   Int
  responseDueAt         DateTime
  resolutionDueAt       DateTime
  status                SLAStatus  @default(ACTIVE)
  responseCompletedAt   DateTime?
  resolutionCompletedAt DateTime?
  breachedAt            DateTime?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  policyId              String?
  department            Department @relation(fields: [departmentId], references: [id])
  grievance             Grievance  @relation(fields: [grievanceId], references: [id], onDelete: Cascade)
  policy                SLAPolicy? @relation(fields: [policyId], references: [id])

  @@index([policyId])
  @@index([departmentId])
  @@index([status])
  @@index([resolutionDueAt])
}

model Feedback {
  id          String    @id @default(cuid())
  grievanceId String
  userId      String
  rating      Int
  comment     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  grievance   Grievance @relation(fields: [grievanceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id])

  @@unique([grievanceId, userId])
  @@index([grievanceId])
  @@index([userId])
}

model Escalation {
  id          String           @id @default(cuid())
  grievanceId String
  level       EscalationLevel
  status      EscalationStatus @default(OPEN)
  reason      String
  createdById String?
  createdAt   DateTime         @default(now())
  resolvedAt  DateTime?
  escalatedAt DateTime         @default(now())
  createdBy   User?            @relation("EscalationCreatedBy", fields: [createdById], references: [id])
  grievance   Grievance        @relation(fields: [grievanceId], references: [id], onDelete: Cascade)

  @@index([grievanceId])
  @@index([level])
  @@index([status])
  @@index([escalatedAt])
}

enum UserRole {
  CITIZEN
  OFFICER
  DEPARTMENT_ADMIN
  SUPER_ADMIN
}

enum GrievanceStatus {
  SUBMITTED
  AI_CLASSIFIED
  ASSIGNED
  IN_PROGRESS
  ESCALATED
  RESOLVED
  REJECTED
  REOPENED
}

enum GrievancePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NotificationType {
  GRIEVANCE_CREATED
  STATUS_CHANGED
  COMMENT_ADDED
  ASSIGNMENT_CHANGED
  SYSTEM
  SLA_WARNING
  ESCALATION_CREATED
}

enum AssignmentType {
  MANUAL
  AUTOMATIC
  AI_RECOMMENDED
  REASSIGNMENT
}

enum AssignmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum SLAStatus {
  ACTIVE
  WARNING
  BREACHED
  COMPLETED
  PAUSED
}

enum EscalationLevel {
  LEVEL_1
  LEVEL_2
  LEVEL_3
  ADMIN
}

enum EscalationStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  CANCELLED
}
