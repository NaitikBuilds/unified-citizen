generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CITIZEN
  OFFICER
  DEPARTMENT_ADMIN
  SUPER_ADMIN
}

enum GrievanceStatus {
  SUBMITTED
  UNDER_REVIEW
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  REJECTED
  CLOSED
}

enum GrievancePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NotificationType {
  GRIEVANCE_CREATED
  STATUS_CHANGED
  COMMENT_ADDED
  ASSIGNMENT_CHANGED
  SLA_WARNING
  ESCALATION_CREATED
  SYSTEM
}

enum AssignmentType {
  MANUAL
  AUTOMATIC
  AI_RECOMMENDED
  REASSIGNMENT
}

enum AssignmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum SLAStatus {
  ACTIVE
  WARNING
  BREACHED
  COMPLETED
  PAUSED
}

enum EscalationLevel {
  LEVEL_1
  LEVEL_2
  LEVEL_3
  ADMIN
}

enum EscalationStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  phone        String?
  role         UserRole @default(CITIZEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  grievances         Grievance[]    @relation("CitizenGrievances")
  comments           Comment[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  attachments        Attachment[]
  assignments        Assignment[]
  refreshTokens      RefreshToken[]
  feedback           Feedback[]
  escalationsCreated Escalation[]   @relation("EscalationCreatedBy")

  @@index([email])
  @@index([departmentId])
}

model Department {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  code        String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  grievances  Grievance[]
  assignments Assignment[]
  slas        SLA[]
}

model Grievance {
  id       String @id @default(cuid())
  ticketId String @unique

  title       String
  description String

  category    String?
  subcategory String?

  status   GrievanceStatus   @default(SUBMITTED)
  priority GrievancePriority @default(MEDIUM)

  location  String?
  latitude  Float?
  longitude Float?

  citizenId String
  citizen   User   @relation("CitizenGrievances", fields: [citizenId], references: [id])

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  assignments      Assignment[]
  comments         Comment[]
  attachments      Attachment[]
  notifications    Notification[]
  aiClassification AIClassification?
  sla              SLA?
  feedback         Feedback[]
  escalations      Escalation[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?

  @@index([ticketId])
  @@index([citizenId])
  @@index([departmentId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

model Assignment {
  id String @id @default(cuid())

  grievanceId String
  grievance   Grievance @relation(fields: [grievanceId], references: [id], onDelete: Cascade)

  officerId String
  officer   User   @relation(fields: [officerId], references: [id])

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  type   AssignmentType
  status AssignmentStatus @default(ACTIVE)

  assignedById String?
  assignedAt   DateTime  @default(now())
  completedAt  DateTime?

  reason String?

  @@index([grievanceId])
  @@index([officerId])
  @@index([departmentId])
  @@index([status])
}

model AIClassification {
  id String @id @default(cuid())

  grievanceId String    @unique
  grievance   Grievance @relation(fields: [grievanceId], references: [id], onDelete: Cascade)

  predictedCategory   String?
  predictedDepartment String?
  predictedPriority   GrievancePriority?

  confidence Float?

  modelName    String?
  modelVersion String?

  explanation String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Comment {
  id String @id @default(cuid())

  content String

  grievanceId String
  grievance   Grievance @relation(fields: [grievanceId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  isInternal Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([grievanceId])
  @@index([authorId])
}

model Attachment {
  id String @id @default(cuid())

  fileName String
  fileUrl  String
  fileType String?
  fileSize Int?

  grievanceId String?
  grievance   Grievance? @relation(fields: [grievanceId], references: [id], onDelete: Cascade)

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())

  @@index([grievanceId])
  @@index([uploadedById])
}

model Notification {
  id String @id @default(cuid())

  type    NotificationType
  title   String
  message String

  isRead Boolean @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  grievanceId String?
  grievance   Grievance? @relation(fields: [grievanceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([grievanceId])
  @@index([isRead])
  @@index([createdAt])
}

model AuditLog {
  id String @id @default(cuid())

  action   String
  entity   String
  entityId String?
  metadata Json?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([entity])
  @@index([entityId])
  @@index([userId])
  @@index([createdAt])
}

model RefreshToken {
  id String @id @default(cuid())

  tokenHash String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model SLA {
  id String @id @default(cuid())

  grievanceId String    @unique
  grievance   Grievance @relation(fields: [grievanceId], references: [id], onDelete: Cascade)

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  responseTimeHours   Int
  resolutionTimeHours Int

  responseDueAt   DateTime
  resolutionDueAt DateTime

  status SLAStatus @default(ACTIVE)

  responseCompletedAt   DateTime?
  resolutionCompletedAt DateTime?
  breachedAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
  @@index([status])
  @@index([resolutionDueAt])
}

model Feedback {
  id String @id @default(cuid())

  grievanceId String
  grievance   Grievance @relation(fields: [grievanceId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  rating  Int
  comment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([grievanceId])
  @@index([userId])
}

model Escalation {
  id String @id @default(cuid())

  grievanceId String
  grievance   Grievance @relation(fields: [grievanceId], references: [id], onDelete: Cascade)

  level  EscalationLevel
  status EscalationStatus @default(OPEN)

  reason String

  createdById String?
  createdBy   User?   @relation("EscalationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([grievanceId])
  @@index([level])
  @@index([status])
}
